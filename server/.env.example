# Which agent runs the AI steps: claude-code | anthropic | gemini
# Unset: whichever API key below is present (Anthropic first), else claude-code.
# claude-code uses the local `claude` CLI and your Claude subscription; no API key needed.
# LLM_PROVIDER=claude-code

# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Optional overrides
# LLM_MODEL=sonnet              # defaults: claude-code "sonnet", anthropic "claude-sonnet-5-5", gemini "gemini-2.5-flash"
# PORT=5050
