# Which agent runs the AI steps: claude-agent-sdk | anthropic | gemini
# Unset: whichever API key below is present (Anthropic first), else claude-agent-sdk.
# claude-agent-sdk uses the Claude Agent SDK on this machine's Claude login; no API key needed (personal use only).
# LLM_PROVIDER=claude-agent-sdk

# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Optional overrides
# LLM_MODEL=sonnet              # defaults: claude-agent-sdk "sonnet", anthropic "claude-sonnet-5-5", gemini "gemini-2.5-flash"
# PORT=5050
# MAIL_POLL_MINUTES=5          # how often connected Gmail inboxes are checked
# MAIL_SECRET=                 # encrypts stored Gmail app passwords; default: random key in server/data/mail.key
